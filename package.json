{
  "name": "highway-hustlers",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test:sunday": "node scripts/test-sunday.mjs && node scripts/test-actors.mjs",
    "test:site": "node scripts/test-site.mjs && node scripts/test-prank-bikes.mjs",
    "test:bike-colours": "node scripts/test-bike-colours.mjs",
    "test:ride-bikes": "node scripts/test-ride-bikes.mjs",
